{
  "name": "games-sa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty",
    "budget": "node scripts/check-bundle.mjs",
    "dev": "npm run dev --workspace @sa/ricochet",
    "build": "npm run build --workspaces --if-present",
    "sim": "npm run sim --workspace @sa/ricochet",
    "pack:itch": "mkdir -p dist-itch && rm -f dist-itch/ricochet.zip && cd games/ricochet/dist && zip -qr ../../../dist-itch/ricochet.zip .",
    "dev:crucible": "npm run dev --workspace @sa/crucible",
    "build:ricochet": "npm run build --workspace @sa/ricochet",
    "build:crucible": "npm run build --workspace @sa/crucible",
    "dev:quartet": "npm run dev --workspace @sa/quartet",
    "build:quartet": "npm run build --workspace @sa/quartet",
    "validate:quartet": "npm run validate --workspace @sa/quartet",
    "dev:literograd": "npm run dev --workspace @sa/literograd",
    "build:literograd": "npm run build --workspace @sa/literograd",
    "dev:lighthouse": "npm run dev --workspace @sa/lighthouse",
    "build:lighthouse": "npm run build --workspace @sa/lighthouse"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
